+#!/usr/bin/env node
+/** Validate the small product-content contract consumed by cambuz-landing. */
+
+import { readFile } from 'node:fs/promises';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
+const MANIFEST = join(ROOT, 'docs', 'landing-content.json');
+
+function fail(message) {
+  throw new Error(`validate-landing-content: ${message}`);
+}
+
+function string(value, label, max = 600) {
+  if (typeof value !== 'string' || value.trim().length === 0 || value.length > max) {
+    fail(`${label} must be a non-empty string of at most ${max} characters`);
+  }
+}
+
+let content;
+try {
+  content = JSON.parse(await readFile(MANIFEST, 'utf8'));
+} catch (error) {
+  fail(`cannot parse docs/landing-content.json: ${error.message}`);
+}
+
+if (!content || typeof content !== 'object' || Array.isArray(content)) fail('manifest must be an object');
+if (content.schemaVersion !== 1) fail('schemaVersion must be 1');
+string(content.releaseNotesPath, 'releaseNotesPath', 180);
+if (!/^[A-Za-z0-9._/-]+\.md$/.test(content.releaseNotesPath) || content.releaseNotesPath.includes('..')) {
+  fail('releaseNotesPath must be a repository-relative Markdown path');
+}
+if (!Array.isArray(content.features) || content.features.length < 1 || content.features.length > 20) {
+  fail('features must contain 1 to 20 entries');
+}
+
+const ids = new Set();
+for (const [index, feature] of content.features.entries()) {
+  if (!feature || typeof feature !== 'object' || Array.isArray(feature)) fail(`features[${index}] must be an object`);
+  string(feature.id, `features[${index}].id`, 48);
+  if (!/^[a-z0-9-]+$/.test(feature.id) || ids.has(feature.id)) {
+    fail(`features[${index}].id must be unique lowercase kebab-case`);
+  }
+  ids.add(feature.id);
+  for (const field of ['headline', 'description', 'screenshotAlt', 'screenshotCaption', 'icon']) {
+    string(feature[field], `features[${index}].${field}`);
+  }
+  if (feature.screenshotId !== undefined) string(feature.screenshotId, `features[${index}].screenshotId`, 48);
+  if (!Array.isArray(feature.bullets) || feature.bullets.length < 1 || feature.bullets.length > 8) {
+    fail(`features[${index}].bullets must contain 1 to 8 strings`);
+  }
+  feature.bullets.forEach((bullet, bulletIndex) =>
+    string(bullet, `features[${index}].bullets[${bulletIndex}]`, 220)
+  );
+}
+
+console.log(`landing content: OK (${content.features.length} features)`);
