@@ -0,0 +1,206 @@
+#!/usr/bin/env node
+/**
+ * Write the published release facts into README.md.
+ *
+ * The release job calls this only after GitHub has accepted every asset. It
+ * fetches the release record back from the GitHub API, so README sizes, direct
+ * URLs and SHA-256 values describe the published files rather than the local
+ * staging directory. The text between the HTML markers in README.md is owned
+ * by this script; product documentation outside those markers remains human
+ * authored.
+ */
+
+import { readFile, writeFile } from 'node:fs/promises';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
+const README = join(ROOT, 'README.md');
+const REPOSITORY = process.env.GITHUB_REPOSITORY || 'rajeshkamboj/cambuz-pdf';
+const API_ROOT = `https://api.github.com/repos/${REPOSITORY}`;
+
+const artifactDefinitions = [
+  {
+    key: 'setup',
+    suffix: '-win-x64-setup.exe',
+    platform: '**Windows 10/11 · x64** *(recommended)*',
+    purpose: 'Normal install: pick a folder, Start Menu entry, optional `.pdf` association. Per-user, no admin rights.',
+    label: 'Download installer',
+  },
+  {
+    key: 'portable',
+    suffix: '-win-x64-portable.exe',
+    platform: 'Windows 10/11 · x64',
+    purpose: 'No install at all — run from Desktop, Downloads or a USB stick (it extracts itself at launch).',
+    label: 'Download portable',
+  },
+  {
+    key: 'appimage',
+    suffix: '-linux-x86_64.AppImage',
+    platform: 'Linux x64 *(experimental)*',
+    purpose: 'Try Cambuz on Linux; single-file AppImage.',
+    label: 'Download AppImage',
+  },
+  {
+    key: 'dmg',
+    suffix: '-mac-arm64.dmg',
+    platform: 'macOS 13+ · Apple Silicon *(experimental)*',
+    purpose: 'Drag-to-Applications disk image; unsigned and not notarized.',
+    label: 'Download DMG',
+  },
+  {
+    key: 'zip',
+    suffix: '-mac-arm64.zip',
+    platform: 'macOS 13+ · Apple Silicon *(experimental)*',
+    purpose: 'Same app bundle as a plain ZIP.',
+    label: 'Download ZIP',
+  },
+];
+
+function fail(message) {
+  throw new Error(`sync-release-readme: ${message}`);
+}
+
+function parseArguments(args) {
+  const options = { tag: undefined, runUrl: undefined, sourceSha: undefined };
+  for (let index = 0; index < args.length; index += 1) {
+    const option = args[index];
+    if (!['--tag', '--run-url', '--source-sha'].includes(option)) {
+      fail(`unknown option ${option}`);
+    }
+    const value = args[index + 1];
+    if (!value || value.startsWith('--')) fail(`${option} needs a value`);
+    options[option.slice(2).replace(/-([a-z])/g, (_, char) => char.toUpperCase())] = value;
+    index += 1;
+  }
+  if (!options.tag || !options.runUrl || !options.sourceSha) {
+    fail('usage: --tag <published-tag> --run-url <workflow-url> --source-sha <commit>');
+  }
+  if (!/^v\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$/.test(options.tag)) fail('invalid release tag');
+  if (!/^https:\/\/github\.com\//.test(options.runUrl)) fail('run URL must be a GitHub URL');
+  if (!/^[0-9a-f]{7,64}$/i.test(options.sourceSha)) fail('source SHA must be a commit hash');
+  return options;
+}
+
+function headers() {
+  const output = {
+    accept: 'application/vnd.github+json',
+    'user-agent': 'cambuz-readme-release-sync',
+    'x-github-api-version': '2022-11-28',
+  };
+  const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;
+  if (token) output.authorization = `Bearer ${token}`;
+  return output;
+}
+
+async function releaseFor(tag) {
+  const response = await fetch(`${API_ROOT}/releases/tags/${encodeURIComponent(tag)}`, {
+    headers: headers(),
+  });
+  if (!response.ok) fail(`GitHub API returned ${response.status} for release ${tag}`);
+  const release = await response.json();
+  if (release.tag_name !== tag || !Array.isArray(release.assets)) fail('release response is malformed');
+  return release;
+}
+
+function digestFor(asset) {
+  const match = /^sha256:([a-f0-9]{64})$/i.exec(asset.digest ?? '');
+  if (!match) fail(`${asset.name} has no GitHub SHA-256 digest`);
+  return match[1].toLowerCase();
+}
+
+function toMiB(bytes) {
+  return `${(bytes / (1024 * 1024)).toFixed(1)} MiB`;
+}
+
+function extractAssets(release) {
+  const assets = {};
+  for (const definition of artifactDefinitions) {
+    const matches = release.assets.filter((asset) => asset.name?.endsWith(definition.suffix));
+    if (matches.length !== 1) fail(`expected one ${definition.suffix} asset, found ${matches.length}`);
+    const [asset] = matches;
+    if (!Number.isSafeInteger(asset.size) || !/^https:\/\/github\.com\//.test(asset.browser_download_url ?? '')) {
+      fail(`invalid published asset ${asset.name}`);
+    }
+    assets[definition.key] = {
+      ...definition,
+      fileName: asset.name,
+      url: asset.browser_download_url,
+      bytes: asset.size,
+      sha256: digestFor(asset),
+    };
+  }
+  const sums = release.assets.find((asset) => asset.name === 'SHA256SUMS.txt');
+  if (!sums || !/^https:\/\/github\.com\//.test(sums.browser_download_url ?? '')) {
+    fail('release is missing a public SHA256SUMS.txt');
+  }
+  return { assets, sums };
+}
+
+function between(source, name, replacement) {
+  const begin = `<!-- release-sync:${name}:start -->`;
+  const end = `<!-- release-sync:${name}:end -->`;
+  const start = source.indexOf(begin);
+  const finish = source.indexOf(end);
+  if (start < 0 || finish < 0 || finish < start) fail(`README is missing ${name} markers`);
+  return `${source.slice(0, start + begin.length)}\n${replacement}\n${source.slice(finish)}`;
+}
+
+function renderBadge(release, version) {
+  const tagForBadge = release.tag_name.replace(/-/g, '--');
+  const kind = release.prerelease ? 'pre--release' : 'release';
+  return `  <a href="${release.html_url}"><img src="https://img.shields.io/badge/download-${tagForBadge}-success" alt="Download ${release.tag_name}" /></a>\n  <img src="https://img.shields.io/badge/version-${version}--${kind}-informational" alt="Version ${version} ${release.prerelease ? 'pre-release' : 'release'}" />`;
+}
+
+function renderDownloadSection(release, version, assets, sums, runUrl, sourceSha) {
+  const kind = release.prerelease ? 'automatic pre-release' : 'release';
+  const rows = artifactDefinitions
+    .map((definition) => {
+      const asset = assets[definition.key];
+      return `| ${definition.platform} | \`${asset.fileName}\` | ${definition.purpose} | ${toMiB(asset.bytes)} | **[${definition.label}](${asset.url})** |`;
+    })
+    .join('\n');
+  const checksumRows = artifactDefinitions
+    .map((definition) => {
+      const asset = assets[definition.key];
+      return `| \`${asset.fileName}\` | \`${asset.sha256}\` |`;
+    })
+    .join('\n');
+
+  return `> **How downloads work:** version **${version}** is published as the\n> **[${release.tag_name} ${kind}](${release.html_url})**. The links below are\n> permanent public release-asset URLs — no GitHub account and no 30-day CI\n> expiry. The builds are **unsigned**: expect SmartScreen and Gatekeeper warnings.\n> This build is produced automatically after a merge to \`main\`; use it as a\n> pre-release build and report problems before relying on it in production.\n\nEvery file below was built from commit \`${sourceSha.slice(0, 10)}\` in\n[CI run](${runUrl}) and attached to the [${release.tag_name} release page](${release.html_url}).\n\n| Platform & architecture | File | Best for | Size | Download |\n| --- | --- | --- | ---: | --- |\n${rows}\n| Windows arm64, Intel Mac, Linux arm64 | — | Not built | — | *unavailable* |\n\nAll five files, plus [\`SHA256SUMS.txt\`](${sums.browser_download_url}), are listed\non the [${release.tag_name} release page](${release.html_url}). Every push to\n\`main\` now receives a public automatic pre-release; the link stays pinned to\nthis exact build rather than to an ambiguous “latest” release.\n\n<details>\n<summary><strong>SHA-256 checksums for the ${release.tag_name} files</strong> (published as <code>SHA256SUMS.txt</code> on the release)</summary>\n\n| File | SHA-256 |\n| --- | --- |\n${checksumRows}\n\nVerify after download: \`Get-FileHash -Algorithm SHA256 <file>\` (PowerShell) or\n\`sha256sum -c SHA256SUMS.txt\` (Linux/macOS, next to the downloaded files). The\nbuilds are unsigned, so the checksum is how you confirm a file is the one CI\nproduced.\n\n</details>`;
+}
+
+function renderLinks(release, assets, sums) {
+  const definitions = [
+    ['release-page', release.html_url],
+    ['win-setup-dl', assets.setup.url],
+    ['win-portable-dl', assets.portable.url],
+    ['linux-dl', assets.appimage.url],
+    ['mac-dmg-dl', assets.dmg.url],
+    ['mac-zip-dl', assets.zip.url],
+    ['sums-dl', sums.browser_download_url],
+  ];
+  return definitions.map(([name, url]) => `[${name}]: ${url}`).join('\n');
+}
+
+async function main() {
+  const options = parseArguments(process.argv.slice(2));
+  const release = await releaseFor(options.tag);
+  const version = options.tag.replace(/^v/, '').replace(/-.*$/, '');
+  const { assets, sums } = extractAssets(release);
+  let readme = await readFile(README, 'utf8');
+  readme = between(readme, 'badge', renderBadge(release, version));
+  readme = between(
+    readme,
+    'downloads',
+    renderDownloadSection(release, version, assets, sums, options.runUrl, options.sourceSha)
+  );
+  readme = between(readme, 'links', renderLinks(release, assets, sums));
+  await writeFile(README, readme);
+  console.log(`README now describes the published ${release.tag_name} release.`);
+}
+
+main().catch((error) => {
+  console.error(error.message ?? String(error));
+  process.exitCode = 1;
+});
